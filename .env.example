# Database (MySQL 8 or TiDB Cloud)
DATABASE_URL="mysql://root:password@localhost:3306/puca_finance"

# Auth.js Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET="your-auth-secret-min-32-chars-long"

# Seed Admin User (First FINANCE_SECRETARY)
SEED_ADMIN_EMAIL="admin@puca.local"
SEED_ADMIN_PASSWORD="TemporaryPassword123"

# Node Environment
NODE_ENV="development"
