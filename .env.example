# Database (MySQL 8 or TiDB Cloud)
DATABASE_URL="mysql://root:password@localhost:3306/puca_finance"

# Auth Secret (generate with `openssl rand -hex 32`)
AUTH_SECRET="your-auth-secret-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Cron Secret for automated maintenance endpoints
CRON_SECRET="your-cron-secret-token"

# Seed Admin User (First FINANCE_SECRETARY)
SEED_ADMIN_EMAIL="admin@puca.local"
SEED_ADMIN_PASSWORD="TemporaryPassword123"

# Node Environment
NODE_ENV="development"

# Cloudflare R2 Storage (S3-compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="puca-finance-receipts"
R2_PUBLIC_DOMAIN=""
