datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FINANCE_SECRETARY
  TREASURER
  PRESBYTERY_VIEWER
}

enum DenominationKind {
  NOTE
  COIN
}

enum ServiceType {
  SUNDAY
  MIDWEEK
  SPECIAL
  OTHER
}

enum ServiceStatus {
  OPEN
  COUNTED
  LOCKED
}

enum StatementFileType {
  CSV
  XLSX
}

enum MomoTransactionDirection {
  IN
  OUT
}

enum MomoTransactionStatus {
  AUTO
  CONFIRMED
  NEEDS_REVIEW
  IGNORED
}

enum RuleMatchType {
  CONTAINS_WORD
  CONTAINS
}

enum ReconciliationStatus {
  DRAFT
  READY
  SUBMITTED
}

enum ExpensePaymentMethod {
  CASH
  MOMO
  BANK
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  VOIDED
}

enum DepositKind {
  CASH_DEPOSIT
  MOMO_TRANSFER
}

enum DepositStatus {
  PENDING_CONFIRMATION
  CONFIRMED
}

enum AttachmentEntityType {
  EXPENSE
  DEPOSIT
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(1)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs          AuditLog[]      @relation("ActorAuditLogs")
  countedServices    ServiceRecord[] @relation("CountedByServices")
  issuedReceipts     Receipt[]       @relation("IssuedReceipts")

  uploadedMomoImports        MomoImport[]         @relation("UploadedMomoImports")
  rolledBackMomoImports      MomoImport[]         @relation("RolledBackMomoImports")
  reviewedMomoTransactions   MomoTransaction[]    @relation("ReviewedMomoTransactions")
  createdClassificationRules ClassificationRule[] @relation("CreatedClassificationRules")
  submittedPeriods           ReconciliationPeriod[] @relation("SubmittedPeriods")
  unlockedPeriods            PeriodUnlock[]         @relation("UnlockedPeriods")
  requestedExpenses          Expense[]              @relation("RequestedExpenses")
  approvedExpenses           Expense[]              @relation("ApprovedExpenses")
  voidedExpenses             Expense[]              @relation("VoidedExpenses")
  carriedDeposits            Deposit[]              @relation("CarriedDeposits")
  confirmedDeposits          Deposit[]              @relation("ConfirmedDeposits")
  uploadedAttachments        Attachment[]
  generatedStatements        StatementLog[]              @relation("GeneratedStatements")
  recordedDistrictPayments   DistrictRemittancePayment[] @relation("RecordedDistrictPayments")
  idempotencyKeys            IdempotencyKey[]

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Denomination {
  id         String           @id @default(cuid())
  value      Decimal          @unique @db.Decimal(6, 2)
  kind       DenominationKind
  sortOrder  Int
  active     Boolean          @default(true)

  countLines CountLine[]

  @@map("denominations")
}

model GivingCategory {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  sortOrder           Int
  active              Boolean              @default(true)

  countSheets         CountSheet[]
  givingEntries       GivingEntry[]
  momoTransactions    MomoTransaction[]
  classificationRules ClassificationRule[]
  districtAllocationRules DistrictAllocationRule[]

  @@map("giving_categories")
}

model ChurchSettings {
  id                String   @id @default("singleton")
  churchName        String
  presbyteryName    String
  weekEndsOn        Int      @default(0)
  parallelRunActive Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("church_settings")
}

model Member {
  id           String        @id @default(cuid())
  memberNumber String?       @unique
  fullName     String
  phone        String?       @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  givingEntries    GivingEntry[]
  momoTransactions MomoTransaction[]
  statementLogs    StatementLog[]

  @@map("members")
}

model ServiceRecord {
  id          String                @id @default(cuid())
  serviceDate DateTime              @db.Date
  serviceType ServiceType
  title       String?
  status      ServiceStatus         @default(OPEN)
  countedById String?
  countedBy   User?                 @relation("CountedByServices", fields: [countedById], references: [id], onDelete: SetNull)
  witnessName String?
  notes       String?               @db.Text
  periodId    String?
  period      ReconciliationPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  countSheets   CountSheet[]
  givingEntries GivingEntry[]

  @@unique([serviceDate, serviceType, title])
  @@map("service_records")
}

model CountSheet {
  id              String        @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  categoryId      String
  category        GivingCategory @relation(fields: [categoryId], references: [id])
  total           Decimal       @db.Decimal(12, 2)

  lines           CountLine[]

  @@unique([serviceRecordId, categoryId])
  @@map("count_sheets")
}

model CountLine {
  id             String       @id @default(cuid())
  countSheetId   String
  countSheet     CountSheet   @relation(fields: [countSheetId], references: [id], onDelete: Cascade)
  denominationId String
  denomination   Denomination @relation(fields: [denominationId], references: [id])
  quantity       Int
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@unique([countSheetId, denominationId])
  @@map("count_lines")
}

model GivingEntry {
  id              String         @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord  @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  categoryId      String
  category        GivingCategory @relation(fields: [categoryId], references: [id])
  memberId        String?
  member          Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  payerName       String?
  amount          Decimal        @db.Decimal(12, 2)
  receiptId       String?        @unique
  receipt         Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("giving_entries")
}

model Receipt {
  id          String       @id @default(cuid())
  number      String       @unique
  amount      Decimal      @db.Decimal(12, 2)
  issuedAt    DateTime     @default(now())
  issuedById  String
  issuedBy    User         @relation("IssuedReceipts", fields: [issuedById], references: [id])

  givingEntry GivingEntry?

  @@map("receipts")
}

model ReceiptSequence {
  year Int @id
  last Int @default(0)

  @@map("receipt_sequences")
}

model ParserProfile {
  id         String            @id @default(cuid())
  name       String
  fileType   StatementFileType
  headerRow  Int               @default(1)
  columnMap  Json
  dateFormat String            @default("YYYY-MM-DD")
  amountSign String            @default("POSITIVE_IN_NEGATIVE_OUT")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  imports    MomoImport[]

  @@map("parser_profiles")
}

model MomoImport {
  id              String        @id @default(cuid())
  fileName        String
  fileHash        String        @unique
  parserProfileId String
  parserProfile   ParserProfile @relation(fields: [parserProfileId], references: [id])
  uploadedById    String
  uploadedBy      User          @relation("UploadedMomoImports", fields: [uploadedById], references: [id])
  rowsTotal       Int
  rowsImported    Int
  rowsDuplicate   Int
  rowsSkipped     Int
  periodStart     DateTime?
  periodEnd       DateTime?
  rolledBackAt    DateTime?
  rolledBackById  String?
  rolledBackBy    User?         @relation("RolledBackMomoImports", fields: [rolledBackById], references: [id])
  createdAt       DateTime      @default(now())

  transactions    MomoTransaction[]

  @@map("momo_imports")
}

model MomoTransaction {
  id                    String                   @id @default(cuid())
  importId              String
  import                MomoImport               @relation(fields: [importId], references: [id], onDelete: Cascade)
  externalRef           String?
  occurredAt            DateTime
  direction             MomoTransactionDirection
  amount                Decimal                  @db.Decimal(12, 2)
  counterpartyName      String?
  counterpartyPhone     String?
  rawDescription        String                   @db.Text
  normalizedDescription String                   @db.Text
  categoryId            String?
  category              GivingCategory?          @relation(fields: [categoryId], references: [id])
  memberId              String?
  member                Member?                  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status                MomoTransactionStatus
  matchedRuleId         String?
  matchedRule           ClassificationRule?      @relation(fields: [matchedRuleId], references: [id], onDelete: SetNull)
  reviewedById          String?
  reviewedBy            User?                    @relation("ReviewedMomoTransactions", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt            DateTime?
  periodId              String?
  period                ReconciliationPeriod?    @relation(fields: [periodId], references: [id], onDelete: SetNull)
  locked                Boolean                  @default(false)
  rawRow                Json
  duplicateHash         String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status])
  @@index([occurredAt])
  @@index([externalRef])
  @@index([duplicateHash])
  @@index([periodId])
  @@map("momo_transactions")
}

model ClassificationRule {
  id                  String            @id @default(cuid())
  pattern             String
  matchType           RuleMatchType
  categoryId          String
  category            GivingCategory    @relation(fields: [categoryId], references: [id])
  priority            Int
  active              Boolean           @default(true)
  createdById         String
  createdBy           User              @relation("CreatedClassificationRules", fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  matchedTransactions MomoTransaction[]

  @@map("classification_rules")
}

model ReconciliationPeriod {
  id             String               @id @default(cuid())
  weekEnding     DateTime             @unique @db.Date
  status         ReconciliationStatus @default(DRAFT)
  bookTotal      Decimal?             @db.Decimal(12, 2)
  varianceReason String?              @db.Text
  submittedAt    DateTime?
  submittedById  String?
  submittedBy    User?                @relation("SubmittedPeriods", fields: [submittedById], references: [id], onDelete: SetNull)
  reportVersion  Int                  @default(0)
  snapshot       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  unlocks          PeriodUnlock[]
  serviceRecords   ServiceRecord[]
  momoTransactions MomoTransaction[]
  districtRemittance DistrictRemittance?

  @@map("reconciliation_periods")
}

model PeriodUnlock {
  id           String               @id @default(cuid())
  periodId     String
  period       ReconciliationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  unlockedById String
  unlockedBy   User                 @relation("UnlockedPeriods", fields: [unlockedById], references: [id])
  reason       String               @db.Text
  createdAt    DateTime             @default(now())

  @@map("period_unlocks")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id              String               @id @default(cuid())
  expenseDate     DateTime             @db.Date
  categoryId      String
  category        ExpenseCategory      @relation(fields: [categoryId], references: [id])
  payee           String
  description     String               @db.Text
  amount          Decimal              @db.Decimal(12, 2)
  paymentMethod   ExpensePaymentMethod
  status          ExpenseStatus        @default(DRAFT)
  requestedById   String
  requestedBy     User                 @relation("RequestedExpenses", fields: [requestedById], references: [id])
  approvedById    String?
  approvedBy      User?                @relation("ApprovedExpenses", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?              @db.Text
  paidAt          DateTime?
  voidedById      String?
  voidedBy        User?                @relation("VoidedExpenses", fields: [voidedById], references: [id], onDelete: SetNull)
  voidedAt        DateTime?
  voidReason      String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([expenseDate])
  @@index([categoryId])
  @@map("expenses")
}

model Deposit {
  id            String         @id @default(cuid())
  depositDate   DateTime       @db.Date
  kind          DepositKind
  amount        Decimal        @db.Decimal(12, 2)
  bankReference String
  carriedById   String
  carriedBy     User           @relation("CarriedDeposits", fields: [carriedById], references: [id])
  confirmedById String?
  confirmedBy   User?          @relation("ConfirmedDeposits", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  status        DepositStatus  @default(PENDING_CONFIRMATION)
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([depositDate])
  @@index([kind])
  @@map("deposits")
}

model Attachment {
  id           String               @id @default(cuid())
  storageKey   String               @unique
  contentType  String
  sizeBytes    Int
  uploadedById String
  uploadedBy   User                 @relation(fields: [uploadedById], references: [id])
  entityType   AttachmentEntityType
  entityId     String
  createdAt    DateTime             @default(now())

  @@index([entityType, entityId])
  @@map("attachments")
}

enum DistrictRemittanceStatus {
  DUE
  PART_PAID
  PAID
}

model DistrictAllocationRule {
  id            String         @id @default(cuid())
  categoryId    String
  category      GivingCategory @relation(fields: [categoryId], references: [id])
  percentage    Decimal        @db.Decimal(5, 2)
  effectiveFrom DateTime       @db.Date
  effectiveTo   DateTime?      @db.Date
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([effectiveFrom])
  @@map("district_allocation_rules")
}

model DistrictRemittance {
  id         String                   @id @default(cuid())
  periodId   String                   @unique
  period     ReconciliationPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  amountDue  Decimal                  @db.Decimal(12, 2)
  amountPaid Decimal                  @default(0) @db.Decimal(12, 2)
  paidOn     DateTime?                @db.Date
  reference  String?
  status     DistrictRemittanceStatus @default(DUE)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  payments   DistrictRemittancePayment[]

  @@index([status])
  @@map("district_remittances")
}

model DistrictRemittancePayment {
  id           String             @id @default(cuid())
  remittanceId String
  remittance   DistrictRemittance @relation(fields: [remittanceId], references: [id], onDelete: Cascade)
  amount       Decimal            @db.Decimal(12, 2)
  paidOn       DateTime           @db.Date
  reference    String?
  recordedById String
  recordedBy   User               @relation("RecordedDistrictPayments", fields: [recordedById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([remittanceId])
  @@map("district_remittance_payments")
}

model StatementLog {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rangeStart    DateTime @db.Date
  rangeEnd      DateTime @db.Date
  generatedById String
  generatedBy   User     @relation("GeneratedStatements", fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([memberId])
  @@index([generatedById])
  @@map("statement_logs")
}

model IdempotencyKey {
  key          String   @id
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  operation    String
  responseJson Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  points    Int      @default(1)
  expiresAt DateTime

  @@index([key, expiresAt])
  @@map("rate_limit_attempts")
}


