datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  FINANCE_SECRETARY
  TREASURER
  PRESBYTERY_VIEWER
}

enum DenominationKind {
  NOTE
  COIN
}

enum ServiceType {
  SUNDAY
  MIDWEEK
  SPECIAL
  OTHER
}

enum ServiceStatus {
  OPEN
  COUNTED
  LOCKED
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLogs          AuditLog[]      @relation("ActorAuditLogs")
  countedServices    ServiceRecord[] @relation("CountedByServices")
  issuedReceipts     Receipt[]       @relation("IssuedReceipts")

  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Denomination {
  id         String           @id @default(cuid())
  value      Decimal          @unique @db.Decimal(6, 2)
  kind       DenominationKind
  sortOrder  Int
  active     Boolean          @default(true)

  countLines CountLine[]

  @@map("denominations")
}

model GivingCategory {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  sortOrder     Int
  active        Boolean       @default(true)

  countSheets   CountSheet[]
  givingEntries GivingEntry[]

  @@map("giving_categories")
}

model ChurchSettings {
  id             String   @id @default("singleton")
  churchName     String
  presbyteryName String
  weekEndsOn     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("church_settings")
}

model Member {
  id           String        @id @default(cuid())
  memberNumber String?       @unique
  fullName     String
  phone        String?       @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  givingEntries GivingEntry[]

  @@map("members")
}

model ServiceRecord {
  id          String        @id @default(cuid())
  serviceDate DateTime      @db.Date
  serviceType ServiceType
  title       String?
  status      ServiceStatus @default(OPEN)
  countedById String?
  countedBy   User?         @relation("CountedByServices", fields: [countedById], references: [id], onDelete: SetNull)
  witnessName String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  countSheets   CountSheet[]
  givingEntries GivingEntry[]

  @@unique([serviceDate, serviceType, title])
  @@map("service_records")
}

model CountSheet {
  id              String        @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  categoryId      String
  category        GivingCategory @relation(fields: [categoryId], references: [id])
  total           Decimal       @db.Decimal(12, 2)

  lines           CountLine[]

  @@unique([serviceRecordId, categoryId])
  @@map("count_sheets")
}

model CountLine {
  id             String       @id @default(cuid())
  countSheetId   String
  countSheet     CountSheet   @relation(fields: [countSheetId], references: [id], onDelete: Cascade)
  denominationId String
  denomination   Denomination @relation(fields: [denominationId], references: [id])
  quantity       Int
  lineTotal      Decimal      @db.Decimal(12, 2)

  @@unique([countSheetId, denominationId])
  @@map("count_lines")
}

model GivingEntry {
  id              String         @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord  @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)
  categoryId      String
  category        GivingCategory @relation(fields: [categoryId], references: [id])
  memberId        String?
  member          Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  payerName       String?
  amount          Decimal        @db.Decimal(12, 2)
  receiptId       String?        @unique
  receipt         Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("giving_entries")
}

model Receipt {
  id          String       @id @default(cuid())
  number      String       @unique
  amount      Decimal      @db.Decimal(12, 2)
  issuedAt    DateTime     @default(now())
  issuedById  String
  issuedBy    User         @relation("IssuedReceipts", fields: [issuedById], references: [id])

  givingEntry GivingEntry?

  @@map("receipts")
}

model ReceiptSequence {
  year Int @id
  last Int @default(0)

  @@map("receipt_sequences")
}

